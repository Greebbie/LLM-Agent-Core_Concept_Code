# ====================================================================
# Enterprise AI Training v2 — 环境变量模板
# ====================================================================
# 用法：
#   1. cp .env.example .env
#   2. 选一个后端（推荐 dashscope，国内稳定快速），填入对应 API key
#   3. 其它后端的字段保持空白即可
# ====================================================================

# ─────────────── 主开关 ───────────────
# 选项：dashscope | openai | ollama | huggingface
LLM_BACKEND=dashscope
EMBEDDING_BACKEND=dashscope

# ─────────────── DashScope（阿里云通义，推荐）───────────────
DASHSCOPE_API_KEY=
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# ─────────────── OpenAI ───────────────
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# ─────────────── Ollama 本地 ───────────────
# OLLAMA_HOST=http://localhost:11434
# LLM_MODEL=qwen2.5:7b
# EMBEDDING_MODEL=nomic-embed-text

# ─────────────── HuggingFace 本地 ───────────────
# HF_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# HF_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

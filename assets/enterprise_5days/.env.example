# ====================================================================
# Enterprise AI 5-Day Training — 环境变量模板
# ====================================================================

# ─────────────── LLM / Embedding 主开关 (与 3 天版相同) ───────────────
LLM_BACKEND=dashscope
EMBEDDING_BACKEND=dashscope
DASHSCOPE_API_KEY=
LLM_MODEL=qwen-plus-2025-01-25
# 如需使用最新别名，可改成：LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# ─────────────── Day 5 LLMOps：Langfuse 配置（可选，llmcs / Python 3.11 已支持） ───────────────
# 默认不填 key 会走 mock observer，不需要连外部服务。
# 如需真实 Langfuse dashboard，在 llmcs 环境中填写下面 3 项即可。
# 选项 A：Langfuse Cloud (注册 https://langfuse.com 拿 key)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# 选项 B：本地 self-host (docker-compose up langfuse)
# LANGFUSE_HOST=http://localhost:3000

# ─────────────── Day 4 MCP：可选远程 server URL ───────────────
# 默认用 stdio transport 本地起；如要测远程 server：
# MCP_SERVER_URL=http://localhost:8000/mcp

# ─────────────── 兜底：禁用可观测时跳过 ───────────────
# OBSERVABILITY_ENABLED=false   # 设为 false 让 @observe 走 mock，不连 Langfuse
